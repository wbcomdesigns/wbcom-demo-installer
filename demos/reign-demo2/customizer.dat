#masthead .container{
	max-width:100%;
}


#buddypress .wbtm-bps-form-wrapper.wbtm-bps-form-wrapper-horizontal .standard-form div.submit input {
	margin-top: 25px !important;

}

.wbtm-bps-form-wrapper-horizontal input[name="field_113_age_range_max"], .wbtm-bps-form-wrapper-horizontal input[name="field_113_age_range_min"] {
    width: 44% !important;
}

.wbtm-bps-form-wrapper.wbtm-bps-form-wrapper-2587 .standard-form div.submit input {
    width: 62%;
    color: #fff !important;
    letter-spacing: 1px;
    background-color: #24152c !important;
    border: 0px !important;
	height: 38px;
    font-size: 15px !important;
	border-radius: 0px !important;
}
.wbtm-bps-form-wrapper.wbtm-bps-form-wrapper-2587 .standard-form div.submit{
	text-align: right;
}
#buddypress div#item-header div#item-meta {
    font-size: 80%;
    color: white;
}
.wbtm-bps-form-wrapper h4 {
    color: white;
}

a.btn-login:hover {
    color: #f7f7f7;
}
a.btn-register:hover {
    color: #f7f7f7;
}

.ls-wp-container .wbtm-bps-form-wrapper h2{
		color: #fff;
    font-size: 3vw;
    line-height: normal;
    font-style: italic;
	margin:0;
}
.ls-wp-container #buddypress .standard-form label{
	font-size: 16px;
	font-weight: 400;
}
.ls-wp-container #buddypress .wbtm-bps-form-wrapper .standard-form select{
	border-radius:3px;
}
@media only screen and (max-width: 767px){
	.standard-form.bps_form.wbtm-bps-form.wbtm-bps-form-horizontal {
	flex-flow: column;
}
	.wbtm-bps-form-wrapper-horizontal input[name="field_113_age_range_max"], .wbtm-bps-form-wrapper-horizontal input[name="field_113_age_range_min"] {
    width: 10% !important;
}
}

/********* Search Profile *****************/
.wbtm-bps-form-wrapper-3080{
	border: none;
	margin: 0;
	padding: 0;
	max-width: 380px;
}
.wbtm-bps-form-wrapper-3080 .field_birthday input{
	width:45% !important;
}
.wbtm-bps-form-wrapper-3080 .editfield{
	margin-bottom:10px;
	color:#fff;
}
.wbtm-bps-form-wrapper-3080 .editfield label{
	margin:0 !important;
	font-weight:600 !important;
}
.wbtm-bps-form-wrapper-3080 input[type="submit"]{
	padding: 12px 30px !important;
	border: 0px !important;
	font-weight: 700 !important;
	letter-spacing: 1px;
}
.wbtm-bps-form-wrapper-3080 input[type="submit"]:hover{
	background:rgba(0, 0, 0, 0.52);
}

