body{
	background-color: #fff !important;
}

.geodir-loc-bar{
	padding: 0px !important;
	border: 0px !important;
	margin: 0px !important;
}
.geodir-loc-bar-in {
    background: #f3f3f3;
    border: 0px !important;
    padding: 10px;
    margin: 0 auto;
    width: 80%;
}
.bestof-tabs-on-left dl.geodir-tab-head dd {
    float: left !important;
    width: 100%;
    border-bottom: 1px solid #E1E1E1;
}

.buddypress .content-wrapper {
padding-top: 0;
padding-bottom: 0;
}
a.btn-login, a.btn-register {
    color: #1d70a3;
    font-size: 14px;
}
/**/
.page-id-2894 .geodir-listing-search .gd-search-input-wrapper input.search_text, .page-id-2894 .gd-search-input-wrapper input.snear {
    border-radius: 50px !important;
}
.page-id-2894 .geodir-listing-search button.geodir_submit_search i.fa.fa-search {
    font-size: 25px;
}
.page-id-2894 .geodir-listing-search button.geodir_submit_search:hover {
    color: #fff !important;
}
.page-id-2894 .geodir-listing-search .geodir-loc-bar-in {
    background: transparent;
}
.page-id-2894 .geodir-listing-search button.geodir_submit_search {
    border: none;
}
.interest .elementor-element-dab5423 {
    border: 3px solid;
    border-radius: 100%;
    padding: 67px 15px;
    transform: rotate(-35Deg);
    border-color: #ffd9ff #fc4fdd #5ed5cb #ffb739;
}
.interest h5 {
    text-align: center;
    color: #fff;
}
.interest .geodir-cat-list ul li {
    border: none;
    margin-right: 3px;
}
.interest .geodir-cat-list ul li a {
