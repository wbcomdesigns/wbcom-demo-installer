    padding:  0px;
    margin-bottom: 0px;
}
.latest_places .geodir_locations {
    border: none;
}
.latest_places a.geodir-viewall {
    display: none;
}
.latest_places .geodir_list_heading {
    text-align: center;
}
.latest_places h5 {
    font-size: 59px;
}
.geodir_category_list_view li.gridview_onefourth {
    box-shadow: 0 0 10px 0 rgba(0,0,0,.15);
    border: none;
    padding: 0px;
    margin-left:  10px;
