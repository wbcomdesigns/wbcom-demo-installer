    border-radius: 3px !important;
}
.latest_places .geodir_locations.geodir_location_listing {
    padding: 0px;
}
.latest_places .geodir-content {
    padding: 0px 30px !important;
    margin: 0px !important;
    width: 100% !important;
}
.latest_places .geodir-addinfo.clearfix {
    padding: 15px 30px;
    border-top: 1px solid #eaeaea;
    margin: 0px !important;
    width: 100% !important;
}
.latest_places .geodir_category_list_view li.gridview_onefourth:hover {
    box-shadow: 0 0 30px 0 rgba(0,0,0,.15);
}
.page-id-2894 .elementor-element-c750e3e article h3.elementor-post__title {
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
}
@media only screen and (min-width:1025px){
.geodir_category_list_view li.gridview_onefourth {
    width: 23%;
}
}
@media only screen and (min-width:768px) and (max-width:1024px){
.geodir_category_list_view li.gridview_onefourth {
    width: 46%;
}
}
@media only screen and (max-width:767px){
.geodir_category_list_view li.gridview_onefourth {
    width: 100%;
}
}
/*snow-fall*/
.bubbles_wrap {
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
}
.bubble {
    border-radius: 50%;
    box-shadow: none;
    height: 5px;
    position: absolute;
    width: 5px;
}
.x1 {
    -webkit-animation: animateBubble 15s linear infinite, sideWays 2s ease-in-out infinite alternate;
    -moz-animation: animateBubble 15s linear infinite, sideWays 2s ease-in-out infinite alternate;
    animation: animateBubble 15s linear infinite, sideWays 2s ease-in-out infinite alternate;
    left: 6%;
    top: 45%;
    background: #ffb739;
}
