.header-right .fa{
font: normal normal normal 18px/1 FontAwesome;
}
.rg-group-section .item-list.rg-group-list .item-title {
    margin-bottom: 5px;
    font-weight: 500;
}

/* Footer Section widget */
footer div.footer-wrap .widget-title {
    font-weight: normal;
}
ul.bupr-member-main li.bupr-members .bupr-member-title{
    font-weight: normal;
	font-size:18px;
}
.footer-wrap .container {
    max-width: 1170px;
}
.footer-wrap .textwidget p{font-size:16px;}
.footer-wrap span.fas.fa-star,
.footer-wrap span.fas.fa-star-half-alt{
    font-size: 12px;
}
footer div#reign-copyright-text{font-size:14px;}
.footer-wrap {
    padding: 30px 0;
}

/* membership-levels */
#pmpro_levels_table{background:none}
.rtm_pmpro_levels_plan .rtm_pmpro_price {
	background: #fff !important;
    box-shadow: 0 0px 5px 5px rgba(0, 0, 0, 0.06);
    -moz-box-shadow: 0 0px 5px 5px rgba(0, 0, 0, 0.06);
    border-radius: 5px;
}
.rtm-pmpro-now-price,
.rtm_pmpro_levels_plan .rtm_levels_table_price strong{
    color: #e7421c !important;
}
#pmpro_levels_table .pmpro_btn {
    background: #e7421c;
    color: #fff;
    text-transform: none;
    border-radius: 4px;
    border: none;
    box-shadow: 0 8px 15px #ccc;
	letter-spacing:0.5px;
}
.rtm_pmpro_levels_plan .rtm_levels_table_des ul li {
    margin: 8px 0;
	  text-transform: none;
    font-size: 16px;
}
.rtm_pmpro_levels_plan .rtm_pmpro_price_top h2 {
    font-size: 22px;
    text-transform: none;
    font-weight: 500;
    color: #000;
}";}