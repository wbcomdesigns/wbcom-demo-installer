{}s:36:"bp_nouveau_appearance[groups_layout]";i:3;s:38:"bp_nouveau_appearance[groups_dir_tabs]";i:0;}s:6:"wp_css";s:2141:"header#masthead.site-header{
background: #4853b3;
background: -moz-linear-gradient(left,  #4853b3 0%, #6743b9 100%); 
background: -webkit-linear-gradient(left,  #4853b3 0%,#6743b9 100%); 
background: linear-gradient(to right,  #4853b3 0%,#6743b9 100%); 
filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#4853b3', endColorstr='#6743b9',GradientType=1 );

}

.main-navigation > ul{
	text-align:center;
}
.main-navigation ul li > ul.sub-menu{
	text-align:left;
}
.reign-full_width_no_title .content-wrapper{
	padding:0 15px;
}
.fa{
        font-family: "FontAwesome" !important;
}
.fab {
    font-family: "Font Awesome 5 Brands" !important;
}
.far, .fas{
	    font-family: "Font Awesome 5 Free" !important;
}

.widget.earned_user_achievements_class{
	overflow:hidden;
}
.widget.earned_user_achievements_class ul{
	margin:0;
}


div#lm-course-archive-data.lm-grid-view .lm-course-item-wrapper{
	overflow:hidden;
  border-radius: 8px;
}
div#lm-course-archive-data.lm-grid-view .lm-course-content, .lm-course-item-wrapper .lm-course-item .lm-course-thumbnail{
	border:0px;
}
div#lm-course-archive-data.lm-grid-view.lm-ld-grid-view .lm-course-item-wrapper:hover {
    transition: all 0.3s;
    transform: translate(0px, -15px);
	  box-shadow: 10px 20px 50px -15px rgba(0,35,178,0.13);
}
div#lm-course-archive-data.lm-grid-view.lm-ld-grid-view .lm-course-item-wrapper{
	    box-shadow: 10px 20px 30px -15px rgba(0,35,178,0.07);
}

#bupr-view-review-btn{
	display:none;
}
.blog .thumbnail-view, .archive .thumbnail-view{
	box-shadow: 0 0px 10px 0 rgba(187, 159, 214, 0.13);
    border-radius: 8px;
    overflow: hidden;
}

#lm-course-archive-data .button, .read-more, a.rg-action, .load-more a{
	border-radius: 100px !important;
  background-image: linear-gradient(91deg, #b30dff 0%, #2d59ff 100%) !important;
  box-shadow: 0 0 15px rgb(209, 216, 255);
  padding:10px 30px !important; 
	text-transform:uppercase !important;
	font-weight: 800 !important;
	font-size: 13px !important;
	line-height: 1.7;
	text-align: center;
	height: auto;
}

.lm-course-image{
	border-radius: 8px;
  box-shadow: 0 0 15px rgba(209, 216, 255, 0.56);
}
";}